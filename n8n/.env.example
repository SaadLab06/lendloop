# For the local n8n in docker-compose.yml. Copy to n8n/.env (git-ignored).

# Encrypts credentials inside n8n. Generate once and keep it: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Used by n8n/import.sh to create the two n8n credentials. Must match the Convex env vars.
N8N_WEBHOOK_SECRET=
N8N_API_SECRET=
