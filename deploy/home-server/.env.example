# Copy to .env next to compose.yml on the server and chmod 600 it. Never commit the real file.

# LAN address the published ports bind to (Docker-published ports bypass ufw).
LAN_IP=192.168.0.190

# --- Convex backend ---
# 32 random bytes as hex: openssl rand -hex 32. The admin key is derived from it.
CONVEX_INSTANCE_SECRET=
# Public URLs of the backend. Use the LAN values until the tunnel hostnames exist, then:
#   CONVEX_CLOUD_ORIGIN=https://lendloop-api.saadlabri.com
#   CONVEX_SITE_ORIGIN=https://lendloop-site.saadlabri.com
CONVEX_CLOUD_ORIGIN=http://192.168.0.190:3210
CONVEX_SITE_ORIGIN=http://192.168.0.190:3211
# From: docker compose exec convex ./generate_admin_key.sh  (used by the Convex CLI and dashboard)
CONVEX_SELF_HOSTED_ADMIN_KEY=

# --- Integration secrets (kept here as the source of truth for n8n/import.sh) ---
# The same values are set on the Convex deployment with npx convex env set.
N8N_WEBHOOK_SECRET=
N8N_API_SECRET=
N8N_WEBHOOK_URL=https://n8n.saadlabri.com/webhook/lendloop-loan-event
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev

# --- Next.js app (NEXT_PUBLIC_* are baked in at build time) ---
NEXT_PUBLIC_CONVEX_URL=http://192.168.0.190:3210
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
