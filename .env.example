# Next.js app and Convex CLI. Copy to .env.local (git-ignored).

# --- Convex ---
# Written by `npx convex dev` when you pick a deployment (cloud, local or anonymous).
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
# Optional: server-side URL for Convex when the browser URL is not reachable from the server
# (for example inside Docker). Defaults to NEXT_PUBLIC_CONVEX_URL.
CONVEX_INTERNAL_URL=
# Only for a self-hosted backend, instead of CONVEX_DEPLOYMENT:
# CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
# CONVEX_SELF_HOSTED_ADMIN_KEY=

# --- Clerk ---
# From the Clerk dashboard (API keys page). pk_test_/sk_test_ for development.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Set these on the Convex deployment, not here ---
# npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your-app>.clerk.accounts.dev
# npx convex env set N8N_WEBHOOK_URL http://localhost:5678/webhook/lendloop-loan-event
# npx convex env set N8N_WEBHOOK_SECRET "$(openssl rand -hex 32)"
# npx convex env set N8N_API_SECRET "$(openssl rand -hex 32)"
